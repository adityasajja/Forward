# ---- App ----
# dev | paper | live
ENV=dev
LOG_LEVEL=INFO
MARKET_SCAN_CACHE_SECONDS=120.0
MARKET_HISTORY_TIMEOUT_SECONDS=45.0
MARKET_HISTORY_START_DATE=2023-07-03
MARKET_HISTORY_WORKERS=6
SAVED_SCANS_PATH=data/scans/custom.json
RESEARCH_DATA_DIRECTORY=data

# ---- IIFL Capital ----
IIFL_APP_KEY=
IIFL_APP_SECRET=
IIFL_REDIRECT_URL=http://127.0.0.1:8000/login/callback
IIFL_BASE_URL=https://api.iiflcapital.com/v1
IIFL_TIMEOUT=15.0
IIFL_SESSION_CACHE=.cache/iifl_session.json
IIFL_DEFAULT_PRODUCT=INTRADAY
IIFL_API_ORDER_SOURCE=forward
# SEBI requires a non-zero market-protection band on API market orders.
IIFL_MARKET_PROTECTION_PERCENT=0.5
# IIFL whitelists an IPv4 address; keep API egress on IPv4 or gated endpoints
# return EC500 "IP address not authorized for trading" over IPv6.
IIFL_FORCE_IPV4=true

# ---- Market data bridge (MQTT) ----
BRIDGE_HOST=bridge.iiflcapital.com
BRIDGE_PORT=8883
BRIDGE_CONNECT_TIMEOUT_SECONDS=15
BRIDGE_RECONNECT_MIN_SECONDS=1
BRIDGE_RECONNECT_MAX_SECONDS=30

# ---- Risk ----
MAX_GROSS_EXPOSURE=5000000
MAX_POSITION_NOTIONAL=1000000
MAX_DAILY_LOSS=50000
MAX_OPEN_POSITIONS=20
ALLOW_SHORT=true
SQUARE_OFF_TIME=15:15

# ---- NSE market schedule ----
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
ORDER_WINDOW_OPEN=09:00
MARKET_CALENDAR_PATH=config/nse_market_calendar.json

# ---- Backtest defaults ----

# ---- API ----
API_HOST=127.0.0.1
API_PORT=8000
# JSON list of browser origins allowed to make credentialed cross-origin calls.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# ---- Local encryption for account secrets ----
# Set a high-entropy key here or create the configured key file before MFA setup.
FORWARD_SECRET_KEY=
FORWARD_SECRET_KEY_FILE=data/.app_secret

# ---- Alerts (notify-only) ----
# Telegram: @BotFather -> /newbot for the token, @userinfobot for your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SMS slot (Fast2SMS key) — activates real SMS when set
FAST2SMS_API_KEY=
