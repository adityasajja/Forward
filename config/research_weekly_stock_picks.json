{
  "daily_data_directory": "data/iifl_daily/NSEEQ",
  "panel_cache_file": "data/self_learning/stock_week_panel.parquet",
  "output_file": "data/self_learning/weekly_stock_picks.json",
  "history_start_date": "2015-01-01",
  "history_end_date": "2026-09-11",
  "week_period": "W-FRI",
  "weeks_per_year": 52,
  "target_return_fraction": 0.05,
  "minimum_daily_turnover_rupees": 10000000.0,
  "minimum_daily_history_bars": 1500,
  "minimum_weekly_bars": 60,
  "momentum_lookback_weeks": [1, 2, 4, 12, 26],
  "volume_surge_lookback_weeks": 12,
  "range_expansion_lookback_weeks": 12,
  "yearly_high_lookback_weeks": 52,
  "breakout_lookback_weeks": 4,
  "forward_return_weeks": [1, 2],
  "maximum_absolute_forward_return": 3.0,
  "filters": {
    "top_decile_ret_1w": {"col": "ret_1w", "quantile": 0.9},
    "top_decile_ret_2w": {"col": "ret_2w", "quantile": 0.9},
    "top_decile_ret_4w": {"col": "ret_4w", "quantile": 0.9},
    "top_decile_ret_12w": {"col": "ret_12w", "quantile": 0.9},
    "top_decile_ret_26w": {"col": "ret_26w", "quantile": 0.9},
    "top_decile_vol_surge": {"col": "vol_surge", "quantile": 0.9},
    "top_decile_range_expansion": {"col": "range_expansion", "quantile": 0.9},
    "top_decile_gap_up": {"col": "gap_up", "quantile": 0.9},
    "near_52w_high": {"col": "near_52w_high", "quantile": 0.9},
    "breakout_4w": {"col": "breakout_4w", "quantile": 0.999},
    "momentum_and_volume": {"combo": ["ret_26w", "vol_surge"]},
    "momentum_and_52w_high": {"combo": ["ret_26w", "near_52w_high"]},
    "momentum_volume_52w_high": {"combo": ["ret_26w", "vol_surge", "near_52w_high"]},
    "short_term_breakout": {"combo": ["ret_1w", "vol_surge", "breakout_4w"]}
  },
  "combo_filter_quantile": 0.9,
  "minimum_filter_sample_count": 200,
  "minimum_top_n_weekly_sample_count": 30,
  "top_n": 10,
  "top_ranked_filters": 3,
  "use_cached_panel": true
}
